generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id        String   @id @default(cuid())
  name      String   @unique
  money     Int      @default(0)
  level     Int      @default(1)
  experience Int    @default(0)
  x         Float    @default(120)
  y         Float    @default(120)
  location  String   @default("city")
  hunger    Int      @default(100)
  energy    Int      @default(100)
  hygiene   Int      @default(100)
  fun       Int      @default(100)
  social    Int      @default(100)
  bladder   Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
